<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- ID -->
    <TextView
        android:id="@+id/textViewIdLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewId"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewIdLabel"
        app:layout_constraintTop_toTopOf="@id/textViewIdLabel" />

    <!-- Title -->
    <TextView
        android:id="@+id/textViewTitleLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewIdLabel" />

    <TextView
        android:id="@+id/textViewTitle"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewTitleLabel"
        app:layout_constraintTop_toTopOf="@id/textViewTitleLabel" />

    <!-- Author -->
    <TextView
        android:id="@+id/textViewAuthorLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/author"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewTitleLabel" />

    <TextView
        android:id="@+id/textViewAuthor"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewAuthorLabel"
        app:layout_constraintTop_toTopOf="@id/textViewAuthorLabel" />

    <!-- Genre -->
    <TextView
        android:id="@+id/textViewGenreLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/genre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewAuthorLabel" />

    <TextView
        android:id="@+id/textViewGenre"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewGenreLabel"
        app:layout_constraintTop_toTopOf="@id/textViewGenreLabel" />

    <!-- Year -->
    <TextView
        android:id="@+id/textViewYearLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/year"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewGenreLabel" />

    <TextView
        android:id="@+id/textViewYear"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewYearLabel"
        app:layout_constraintTop_toTopOf="@id/textViewYearLabel" />

    <!-- Borrow Count -->
    <TextView
        android:id="@+id/textViewBorrowCountLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/borrow_count"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewYearLabel" />

    <TextView
        android:id="@+id/textViewBorrowCount"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewBorrowCountLabel"
        app:layout_constraintTop_toTopOf="@id/textViewBorrowCountLabel" />

    <!-- Is Borrowed -->
    <TextView
        android:id="@+id/textViewIsBorrowedLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/is_borrowed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewBorrowCountLabel" />

    <TextView
        android:id="@+id/textViewIsBorrowed"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewIsBorrowedLabel"
        app:layout_constraintTop_toTopOf="@id/textViewIsBorrowedLabel" />

    <!-- Last Borrowed Timestamp -->
    <TextView
        android:id="@+id/textViewLastBorrowedTimestampLabel"
        style="@style/Poppins.Medium.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/last_borrowed_timestamp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewIsBorrowedLabel" />

    <TextView
        android:id="@+id/textViewLastBorrowedTimestamp"
        style="@style/Poppins.Regular.Normal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/textViewLastBorrowedTimestampLabel"
        app:layout_constraintTop_toTopOf="@id/textViewLastBorrowedTimestampLabel" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/buttonRate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewLastBorrowedTimestampLabel" />

    <!-- Buttons -->
    <Button
        android:id="@+id/buttonRate"
        style="@style/Button.Base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/see_reviews"
        app:layout_constraintBottom_toTopOf="@+id/buttonEditBook"
        app:layout_constraintEnd_toEndOf="@+id/buttonEditBook"
        app:layout_constraintStart_toStartOf="@+id/buttonEditBook" />

    <Button
        android:id="@+id/buttonEditBook"
        style="@style/Button.Base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_book"
        app:layout_constraintBottom_toTopOf="@+id/buttonShowDialog"
        app:layout_constraintEnd_toEndOf="@+id/buttonShowDialog"
        app:layout_constraintStart_toStartOf="@+id/buttonShowDialog" />

    <Button
        android:id="@+id/buttonShowDialog"
        style="@style/Button.Base"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/show_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Group -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:constraint_referenced_ids="buttonRate,buttonEditBook,buttonShowDialog" />

    <!-- Barrier -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="textViewId,textViewTitle,textViewAuthor,textViewGenre,textViewYear,textViewBorrowCount,textViewIsBorrowed,textViewLastBorrowedTimestamp" />

    <TextView
        android:id="@+id/textViewBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:text="@string/barrier"
        app:layout_constraintStart_toEndOf="@id/barrierStart"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
